# Copiar a .env y completar con valores reales. .env nunca se sube al repo.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comentado = usa sqlite local. En produccion, descomentar:
# DATABASE_URL=postgres://user:password@host:port/dbname

TIME_ZONE=UTC

# Mailchimp Transactional (Mandrill)
MANDRILL_API_KEY=
EMAIL_FROM_ADDRESS=soporte@empresa.com
EMAIL_FROM_NAME=Mesa de ayuda TI

# Opcional: si se define, se envia un aviso a este correo por cada ticket nuevo
SOPORTE_TEAM_EMAIL=

# Dominio publico usado para armar links en los correos (ej. encuesta CSAT)
SITE_BASE_URL=http://127.0.0.1:8000
