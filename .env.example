# Copiar a .env y completar con valores reales. .env nunca se sube al repo.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comentado = usa sqlite local. En produccion, descomentar:
# DATABASE_URL=postgres://user:password@host:port/dbname

TIME_ZONE=UTC

# Mailchimp Transactional (Mandrill) - se completa cuando integremos el envio/recepcion de correo
MANDRILL_API_KEY=
